# Playwright MCP scratch output
.playwright-mcp/

# Session working files, not part of the distributable guide
PROMPT.restart

# OS / editor cruft
.DS_Store
*.swp
*~
.*.print.html

# build-cheatsheets.py intermediates — only RUNBOOK.pdf is tracked.
# --keep leaves the per-section PDFs in build/; the HTML is transient; *.tmp is the
# qpdf/fallback scratch file. Listed individually so nothing slips through.
build/
build/**
cheatsheet-*.pdf
.cheatsheet-*.print.html
RUNBOOK.pdf.tmp
